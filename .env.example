# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required only when signals are not already in data/cache/signals.jsonl.
# `make reproduce` runs fully offline from the committed cache and needs no key.
OPENAI_API_KEY=sk-...

# Optional — defaults shown.
LLM_MODEL=gpt-4o-mini

# Hard spend limits, enforced in code before and during the LLM batch
# (sigconf/signals/budget.py). Retries count against both caps.
LLM_MAX_CALLS=400
LLM_MAX_COST_USD=1.00
